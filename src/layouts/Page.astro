---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/spectral/latin-400.css';
import '@fontsource/spectral/latin-500.css';
import '@fontsource/spectral/latin-400-italic.css';
import '../styles/editorial.css';
import Icon from '../components/Icon.astro';
import {root,chapterUrl} from '../lib/edition';
interface Props {title:string, description:string}
const {title,description}=Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#102d45"/><title>{title} · CIMAP</title><meta name="description" content={description}/><meta name="author" content="Martin Morfe.°. · Autor, investigador y desarrollador de la plataforma"/><meta name="recipient" content="Diputado Pedro Infante, Vicepresidente de la Asamblea Nacional de la República Bolivariana de Venezuela"/><meta property="og:type" content="article"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><link rel="icon" type="image/svg+xml" href={root+'favicon.svg'}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/></head>
<body><a class="skip" href="#lectura">Saltar al contenido</a>
<header class="mast"><div class="shell mast-inner"><a href={root} class="wordmark">CIMAP</a><span class="mast-label">Investigación económica</span><nav aria-label="Navegación principal"><a href={root+'#indice'}>Capítulos</a><a href={chapterUrl(11)}>Laboratorio</a><a href={chapterUrl(12)}>Biblioteca</a></nav><button id="open-search" aria-label="Buscar en la publicación"><Icon name="search"/><span>Buscar</span></button></div></header>
<dialog id="search"><form method="dialog" class="dialog-head"><b>Buscar en la edición</b><button aria-label="Cerrar buscador"><Icon name="close"/></button></form><label for="q-global">Capítulos, instrumentos, términos y series</label><input id="q-global" type="search" placeholder="Ej. pensiones, hidrocarburos…" autocomplete="off"/><p id="search-count" role="status"></p><ul id="search-hits"></ul></dialog>
<main id="lectura"><slot/></main>
<footer class="footer"><div class="shell"><div class="footer-col brand-col"><span class="wordmark">CIMAP</span><p class="footer-subbrand">Centro de Investigación y Monitoreo de la Alta Política</p><p class="footer-edition">Edición I · Horizonte 2026–2036</p></div><div class="footer-col meta-col"><div class="meta-item"><span class="meta-label">Autoría y desarrollo</span><strong class="meta-name">Martin Morfe.°.</strong><span class="meta-desc">Autor, investigador y desarrollador de la plataforma<br/>Dirección científica, diseño editorial y desarrollo tecnológico</span></div><div class="meta-item"><span class="meta-label">Destinatario</span><strong class="meta-name">Diputado Pedro Infante</strong><span class="meta-desc">Vicepresidente de la Asamblea Nacional de la República Bolivariana de Venezuela</span></div></div><div class="footer-col link-col"><a href={chapterUrl(12)}>Fuentes y biblioteca <Icon name="arrow"/></a><a href={chapterUrl(2)+'#agenda'}>Agenda legislativa <Icon name="arrow"/></a><a href={chapterUrl(11)}>Laboratorio MISRE <Icon name="arrow"/></a></div></div></footer>
<script>
import {normalize,root} from '../lib/edition';
const dialog=document.querySelector<HTMLDialogElement>('#search')!;
const q=document.querySelector<HTMLInputElement>('#q-global')!;
const list=document.querySelector('#search-hits')!;
const count=document.querySelector('#search-count')!;
type Hit={title:string,text:string,url:string,group:string};
let index:Hit[]|undefined;
function render(){
 if(!index)return;
 const words=normalize(q.value).split(/\s+/);
 const matches=index.filter(x=>words.every(w=>normalize(x.title+' '+x.text+' '+x.group).includes(w)));
 const visible=matches.slice(0,q.value?40:12);
 count.textContent=q.value?matches.length+' resultados · '+visible.length+' visibles':'Índice de capítulos';
 list.replaceChildren(...visible.map(hit=>{
  const li=document.createElement('li'),a=document.createElement('a'),small=document.createElement('small');
  a.href=hit.url;small.textContent=hit.group;a.append(small,hit.title);a.onclick=()=>dialog.close();li.append(a);return li;
 }));
}
document.querySelector('#open-search')!.addEventListener('click',async()=>{
 dialog.showModal();q.focus();
 if(!index){try{const response=await fetch(root+'datos/busqueda.json');if(!response.ok)throw new Error();index=await response.json()}catch{count.textContent='No se pudo cargar el índice. Vuelve a abrir el buscador.';return}}
 render()
});
q.oninput=render;dialog.onclick=e=>{if(e.target===dialog)dialog.close()};
</script></body></html>
