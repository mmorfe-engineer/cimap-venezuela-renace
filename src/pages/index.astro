---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import CoverGraphic from '../components/CoverGraphic.astro';
import {chapters,chapterUrl,num,root,series} from '../lib/edition';
import agenda from '../data/agenda.json';
---
<Page title="Venezuela Renace — De la recuperación económica a la refundación del capital de confianza" description="Publicación económica de CIMAP sobre Venezuela, sus reformas y las condiciones de recuperación en el horizonte 2026–2036.">
<div class="shell">
<div class="issue"><span><i></i> Edición I <b>/</b> Estudios de país</span><span>Noviembre de 2026</span></div>
<section class="cover"><div><p class="eyebrow gold-rule">Investigación económica estratégica</p><h1>Venezuela<br/><em>Renace</em></h1><p class="subtitle">De la recuperación económica a la refundación del capital de confianza.</p><div class="attribution-block"><div class="author-role"><span class="role-tag">Autoría y desarrollo</span><strong class="role-name">Martin Morfe.°.</strong><span class="role-title">Autor, investigador y desarrollador de la plataforma</span><span class="role-details">Dirección científica, diseño editorial y desarrollo tecnológico</span></div><div class="recipient-role"><span class="role-tag">Destinatario</span><strong class="role-name">Diputado Pedro Infante</strong><span class="role-title">Vicepresidente de la Asamblea Nacional de la República Bolivariana de Venezuela</span></div></div><div class="actions"><a class="primary" href={chapterUrl(1)}>Leer la publicación <Icon name="arrow"/></a><a class="secondary" href="#indice">Ver índice <Icon name="chev" size={15}/></a></div></div><CoverGraphic/></section>
<nav class="edition-index" aria-label="Accesos de la edición"><a href="#indice"><Icon name="book"/><strong>12</strong> capítulos</a><a href={chapterUrl(2)+'#agenda'}><Icon name="grid"/><strong>{agenda.length}</strong> fichas de agenda</a><a href={chapterUrl(3)+'#explorador'}><Icon name="diagonal"/><strong>{series.length}</strong> gráficas económicas</a><a href={chapterUrl(11)}><Icon name="lab"/>Laboratorio MISRE <Icon name="arrow" size={15}/></a></nav>
<section class="spotlight"><div><p class="eyebrow gold-rule">Prioridad legislativa</p><h2>De la reforma al<br/><em>hecho verificable.</em></h2><p>¿Qué cambió en la ley y qué sigue en trámite? La agenda reúne los instrumentos, sus dependencias y el hito documental que permite seguir cada reforma.</p><a class="textlink" href={chapterUrl(2)+'#agenda'}>Explorar la agenda <Icon name="arrow"/></a></div><div class="feature-list">{agenda.slice(0,3).map((a,i)=><a href={chapterUrl(2)+'#ficha-'+a.id}><span class="folio">{num(i+1)}</span><div><small>{a.status}</small><b>{a.title}</b></div><Icon name="diagonal"/></a>)}</div></section>
<section class="directory" id="indice"><div class="section-head"><p class="eyebrow">Guía de lectura</p><h2>Índice de la edición</h2></div><div class="contents">{chapters.map(c=><a href={chapterUrl(c.id)}><span class="folio">{num(c.id)}</span><span>{c.title}</span><Icon name="arrow" size={17}/></a>)}</div></section>
<div class="source-band"><img src={root+'cimap.jpg'} width="94" height="66" alt="Logotipo del Plan Venezuela Renace"/><div><strong>El programa de referencia</strong><p>Lectura de CIMAP sobre el programa nacional para la recuperación y la prosperidad, publicado en noviembre de 2026.</p></div><a class="textlink" href={chapterUrl(12)}>Biblioteca <Icon name="arrow"/></a></div></div></Page>
